# --- Postgres ---
POSTGRES_PASSWORD=change-me
# Docker Compose ile çalışırken host adı "postgres" olur (compose servis adı).
# Docker olmadan yerelde çalıştırırken "localhost" kullanın.
DATABASE_URL=postgres://marmara:change-me@postgres:5432/marmara

# --- Auth ---
# Uzun, rastgele bir string olsun: `openssl rand -hex 32` ile üretebilirsiniz.
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_EMAIL_DOMAIN=marun.edu.tr

# --- AWS (S3 + SES) ---
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
SES_FROM_EMAIL=noreply@your-domain.com

# --- Realtime mesajlaşma (ayrı Socket.io süreci) ---
SOCKET_PORT=3001
# Tarayıcının herkese açık olarak erişeceği adres (prod'da nginx aynı domain
# üzerinden yönlendirdiği için boş bırakılabilir; dev'de ayrı port gerekir).
APP_ORIGIN=https://your-domain.com
NEXT_PUBLIC_SOCKET_URL=
# Next.js container'ının socket container'ına Docker ağı üzerinden eriştiği adres.
SOCKET_INTERNAL_URL=http://socket:3001
# `openssl rand -hex 32` ile üretilen, app<->socket servisleri arası paylaşılan gizli anahtar.
INTERNAL_EMIT_SECRET=change-me-to-a-long-random-string

NODE_ENV=production
PORT=3000
